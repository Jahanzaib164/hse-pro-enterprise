# ============================================================
# HSE Pro Enterprise — Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://hse_user:hse_secure_pass@postgres:5432/hse_pro

# ── JWT Authentication ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_64_byte_random_hex
JWT_REFRESH_SECRET=CHANGE_ME_another_64_byte_random_hex
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── System Owner ─────────────────────────────────────────────
# Account matching this email is automatically SYSTEM_OWNER
SYSTEM_OWNER_EMAIL=admin@your-company.com

# ── Email (SMTP) ─────────────────────────────────────────────
# Leave blank to disable email (logged to console instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── File Storage ─────────────────────────────────────────────
# Leave S3 vars blank to use local disk storage
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=hse-pro-files
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Docker ───────────────────────────────────────────────────
DB_PASSWORD=hse_secure_pass
