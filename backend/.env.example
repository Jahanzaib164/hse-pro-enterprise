# ===== Server =====
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ===== Database (PostgreSQL) =====
DATABASE_URL=postgresql://hse_user:hse_secure_pass@localhost:5432/hse_pro
POSTGRES_DB=hse_pro
POSTGRES_USER=hse_user
DB_PASSWORD=hse_secure_pass

# ===== Auth / JWT =====
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# ===== System =====
SYSTEM_OWNER_EMAIL=admin@hse-pro.com

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== Email (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ===== File storage (S3-compatible, optional) =====
# If S3_ENDPOINT and S3_ACCESS_KEY are set, uploads go to S3; otherwise to local uploads/ dir.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=hse-pro-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
